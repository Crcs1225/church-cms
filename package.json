{
  "name": "church-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "node node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3000 --webpack",
    "dev:turbopack": "next dev",
    "dev:webpack": "node node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3000 --webpack",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test:data",
    "build": "node node_modules/next/dist/bin/next build --webpack",
    "prebuild": "npm run verify",
    "db:init": "node node_modules/prisma/build/index.js db push",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:seed": "node scripts/seed-db.mjs",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "start": "next start",
    "lint": "eslint",
    "test:api": "node scripts/test-api.mjs",
    "test:data": "node scripts/test-data.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.9.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^7.8.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run typecheck && npm run lint",
    "pre-push": "npm run verify"
  }
}
